# Copy to .env and edit. Never commit .env.

# false = offline simulation, no API key needed
USE_AZURE_OPENAI=false

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Leave blank for deployments that reject a custom temperature
AZURE_OPENAI_TEMPERATURE=0

TOKENIZER_MODEL=gpt-4o

# simulated = count a representative synthetic response per hit
# fixed     = assume EXPECTED_OUTPUT_TOKENS for every hit
OUTPUT_TOKEN_MODE=simulated
EXPECTED_OUTPUT_TOKENS=350

# USD per 1M tokens. Defaults are GPT-4o Global Standard list price;
# replace with your contracted rate for the deployment you will use.
INPUT_PRICE_PER_1M_TOKENS=2.50
OUTPUT_PRICE_PER_1M_TOKENS=10.00

MONTHLY_ALERTS=10000

# Experiment knobs
# Hits scoring below this are not sent to AI (0 = assess every hit)
AI_MIN_FACTOR_SCORE=0
# Compact JSON evidence uses fewer input tokens than pretty-printed JSON
COMPACT_EVIDENCE_JSON=true
